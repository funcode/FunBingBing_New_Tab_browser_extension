        "ultraHighDef": "/th?id=OHR.MidAutumn2026_ZH-CN8947536773_UHD.jpg",
        "wallpaper": "/th?id=OHR.MidAutumn2026_ZH-CN8947536773_1920x1200.jpg"
      },
      "portrait": {
        "highDef": "/th?id=OHR.MidAutumn2026_ZH-CN8947536773_768x1366.jpg",
