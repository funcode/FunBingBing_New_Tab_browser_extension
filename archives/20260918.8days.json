        "highDef": "/th?id=OHR.KochiaChina_ZH-CN4719995421_1920x1080.jpg",
        "ultraHighDef": "/th?id=OHR.KochiaChina_ZH-CN4719995421_UHD.jpg",
        "wallpaper": "/th?id=OHR.KochiaChina_ZH-CN4719995421_1920x1200.jpg"
